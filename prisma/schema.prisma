generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id       Int    @id @default(autoincrement())
  user     String
  email    String @unique
  password String

  resetToken        String?
  resetTokenExpires DateTime?
}

model Animes {
  id           Int       @id @default(autoincrement())
  title        String
  average      String
  synopisis    String    @db.Text
  capeImage    String
  opinionNinja String?   @db.Text
  categoryId   Int?
  episodes     Int?
  StatusFinished    Boolean?   @default(false)
  Studios      String[]    @db.Text
  DurationEp   String?
  StreamingPlatforms     String[] @db.Text
  DataLancamento Int?
  SubCategorias String[]
  Temp         Int?
  category     Category? @relation(fields: [categoryId], references: [id])
}

model Category {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  animes Animes[]
}
